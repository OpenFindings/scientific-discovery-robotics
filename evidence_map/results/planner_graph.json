{
  "nodes": [
    {
      "node_id": "H1_shift",
      "node_type": "hypothesis",
      "label": "Sign is set by evaluation shift: state hurts out of the training range, is neutral-to-helpful in distribution.",
      "timestamp": null,
      "metadata": {}
    },
    {
      "node_id": "H2_frame",
      "node_type": "hypothesis",
      "label": "The harm comes from absolute frames (and velocity terms); relative or grounded state helps under any evaluation.",
      "timestamp": null,
      "metadata": {}
    },
    {
      "node_id": "H3_fusion",
      "node_type": "hypothesis",
      "label": "Naive fusion lets state dominate optimisation and suppress vision; with regularised/grounded fusion state helps.",
      "timestamp": null,
      "metadata": {}
    },
    {
      "node_id": "H4_observability",
      "node_type": "hypothesis",
      "label": "State helps when cameras miss task-relevant information (single fixed view, bimanual relations); redundant with full wrist views.",
      "timestamp": null,
      "metadata": {}
    },
    {
      "node_id": "H5_heterogeneous",
      "node_type": "hypothesis",
      "label": "No general factor: effects are task- and setup-specific noise.",
      "timestamp": null,
      "metadata": {}
    },
